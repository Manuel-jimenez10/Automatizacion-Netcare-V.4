# ============================================================
# EspoCRM
# ============================================================
ESPOCRM_BASE_URL=https://tu-instancia.espocrm.com
ESPOCRM_API_KEY=tu_api_key_de_espocrm

# ============================================================
# Servidor
# ============================================================
PORT=3000
PUBLIC_URL=https://automatizacion-netcare-v-4-kvin.onrender.com

# ============================================================
# Twilio
# ============================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=https://automatizacion-netcare-v-4-kvin.onrender.com/api/whatsapp/status

# ============================================================
# Templates de Twilio (Content SIDs)
# ============================================================
TWILIO_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_QUOTE_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUOTE_PRESENTED_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUOTE_PRESENTED_NAME=nombre_del_template
PREFACTURA_PRESENTED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACTURA_PRESENTED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACTURA_ADICIONAL=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACTURA_PRESENTED_XML=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PREFACTURA_REMINDER_3DAYS_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PREFACTURA_REMINDER_OVERDUE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MENSAJE_INICIAR_WHATSAPP=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Seguridad
# ============================================================
WEBHOOK_SECRET=tu_secreto_webhook
INTERNAL_WEBHOOK_SECRET=b37da2062c4d946e2642aa837dd274db
STORAGE_TOKEN=token_para_upload_php

# ============================================================
# MENSAJE INFORMATIVO AL CLIENTE (checkbox del agente en el CRM)
# ============================================================
# Template: {{1}} = nombre del contacto, {{2}} = texto que escribe el agente.
WHATSAPP_INFO_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombres INTERNOS de los dos campos custom en la entidad WhatsappMessage.
# Créalos con etiquetas SIN acentos y los nombres internos coincidirán:
#   "Texto Informacion"  -> textoInformacion   (tipo Wysiwyg o Text)
#   "Enviar Informacion" -> enviarInformacion  (tipo Bool / checkbox)
WHATSAPP_INFO_TEXT_FIELD=textoInformacion
WHATSAPP_INFO_TRIGGER_FIELD=enviarInformacion

# Texto plano equivalente para la ventana de 24h. Debe decir lo mismo que el
# template; aquí los saltos de línea SÍ se respetan.
# WHATSAPP_INFO_TEXT_FORMAT=

WHATSAPP_INFO_ENABLED=true
# Usar texto plano cuando el cliente escribió hace menos de 24h (no quema template)
WHATSAPP_INFO_USE_WINDOW=true
# Máximo del texto del agente. El cuerpo total no puede pasar de ~1024 caracteres.
WHATSAPP_INFO_MAX_TEXT_CHARS=700
# Exigir INTERNAL_WEBHOOK_SECRET en /api/whatsapp/send-info.
# Desactivado por defecto para igualar a /api/whatsapp-init/send, cuyo workflow
# tampoco manda cabeceras. Para activarlo, añade "secret" al payload del workflow.
WHATSAPP_INFO_REQUIRE_SECRET=false

# ============================================================
# SEGUIMIENTO DE COTIZACIONES
# ============================================================
# Template al cliente: {{1}} = nombre del cliente, {{2}} = nombre de la cotización.
# Variable NUEVA: no reutilizar TWILIO_QUOTE_TEMPLATE_SID (el viejo lleva el PDF
# en {{1}} y los nombres desplazados).
QUOTE_FOLLOWUP_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Aviso al administrador al enviar el ÚLTIMO seguimiento:
# {{1}} = nombre de la cotización, {{2}} = teléfono del billing contact.
QUOTE_FOLLOWUP_EXHAUSTED_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Texto equivalente para la ventana de 24h del administrador. Si está vacío, el
# aviso SIEMPRE usa el template (no se improvisa la redacción).
# QUOTE_FOLLOWUP_EXHAUSTED_TEXT=

# Campo entero de Quote que cuenta los seguimientos enviados.
# ⚠️ Debe ser el nombre INTERNO de EspoCRM, no la etiqueta. Si te equivocas, el
# módulo aborta con un error explícito en vez de enviar sin control.
QUOTE_FOLLOWUP_COUNTER_FIELD=seguimientoCotizacion

QUOTE_FOLLOWUP_ENABLED=true
QUOTE_FOLLOWUP_MAX_ATTEMPTS=2
QUOTE_FOLLOWUP_DAYS=7
QUOTE_FOLLOWUP_NOTIFY_ADMINS=true

# Tope de envíos por corrida; el resto se atiende al día siguiente. Evita que el
# primer día salgan cientos de templates de golpe. 0 = sin tope.
QUOTE_FOLLOWUP_MAX_PER_RUN=40

# Presupuesto DIARIO compartido por el cron y las llamadas manuales. Sin él,
# repetir /run-followup vaciaría de golpe el backlog diferido. 0 = sin tope.
QUOTE_FOLLOWUP_MAX_PER_DAY=120

# Pausa entre envíos, como en el resto de módulos.
QUOTE_FOLLOWUP_DELAY_MS=1500

# Simulación: calcula y loguea a quién se enviaría, sin enviar nada.
QUOTE_FOLLOWUP_DRY_RUN=false

# Consultar también el historial de Twilio para saber si el cliente respondió.
QUOTE_FOLLOWUP_CHECK_TWILIO=true

# Exigir INTERNAL_WEBHOOK_SECRET en /api/quotes/run-followup.
QUOTE_FOLLOWUP_REQUIRE_SECRET=true

# ============================================================
# Envío masivo
# ============================================================
# Modo prueba: si tiene valor, /send-all-contacts SOLO envía a estos números.
BULK_TEST_RECIPIENTS=
# ID del Report de EspoCRM usado como audiencia. Vacío = reporte por defecto.
BULK_CONTACTS_REPORT_ID=

# Número seguro para pruebas manuales
TEST_PHONE_NUMBER=

# ============================================================
# NOTIFICACIONES A ADMINISTRADORES  (mensajes entrantes)
# ============================================================
# Números que reciben un aviso por CADA mensaje nuevo de un cliente.
# Separados por coma. Se acepta cualquier formato; se normaliza a E.164.
# Vacío = función desactivada. NO pongas aquí los números reales: van en el
# entorno de Render, no en el repositorio.
ADMIN_NOTIFICATION_PHONES=+521XXXXXXXXXX,+521XXXXXXXXXX,+58XXXXXXXXXX

# Template usado SOLO cuando la ventana de 24h del administrador está cerrada.
# Contenido esperado:
#   🔔 Tienes un mensaje nuevo de {{1}}.
#   El contenido es el siguiente: {{2}}. ¡Revisa los detalles en el sistema!
ADMIN_NOTIFICATION_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Texto plano enviado DENTRO de la ventana de 24h. Debe coincidir carácter por
# carácter con el template para que el administrador no note la diferencia.
# Usa \n para el salto de línea si tu gestor de variables lo permite; si no,
# deja el valor por defecto del código.
# ADMIN_NOTIFICATION_TEXT_FORMAT=

# Interruptor general (true por defecto)
ADMIN_NOTIFICATION_ENABLED=true

# Duración de la ventana de servicio en horas. WhatsApp usa 24.
ADMIN_NOTIFICATION_WINDOW_HOURS=24

# Anti-spam opcional: minutos mínimos entre dos templates al MISMO admin
# mientras su ventana siga cerrada. 0 = sin límite (flujo pedido: si el admin
# no responde, se le sigue mandando el template).
ADMIN_NOTIFICATION_TEMPLATE_COOLDOWN_MINUTES=0

# Tope de seguridad: máximo de templates por administrador y por hora. Evita
# que un pico de mensajes queme el sender ante Meta (incidente 63051).
ADMIN_NOTIFICATION_MAX_TEMPLATES_PER_HOUR=20

# Reconstruir la ventana consultando el historial de Twilio tras un reinicio
# (en Render el disco es efímero entre despliegues).
ADMIN_NOTIFICATION_REHYDRATE=true

# Ruta del archivo de estado. Vacío = <cwd>/data/admin-notification-sessions.json
ADMIN_NOTIFICATION_STATE_FILE=

# Registrar en EspoCRM las respuestas de los administradores (false por defecto:
# son ruido interno y no pertenecen a las conversaciones de clientes).
ADMIN_NOTIFICATION_LOG_ADMIN_REPLIES=false

# Longitud máxima del contenido del mensaje dentro de la notificación.
ADMIN_NOTIFICATION_MAX_BODY_CHARS=600

# Exigir el secreto (INTERNAL_WEBHOOK_SECRET) en /api/admin-notifications/*.
# ACTIVO POR DEFECTO: sin él, esos endpoints son un emisor de WhatsApp abierto
# a internet. Se envía en el header x-webhook-secret o en el body { "secret" }.
ADMIN_NOTIFICATION_REQUIRE_SECRET=true
